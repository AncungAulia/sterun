  "rejects": [
    {
      "id": "rj-01-name-blank",
      "note": "Name is nothing but whitespace, so N2/N3 leave an empty string. N4 rejects: an empty component would let two different people share a preimage shape.",
      "input": {
        "name": " \u0009 \u3000\u000a",
        "national_id": "3174012509900001",
        "emergency_contact": "+6281234567890",
        "salt_hex": "a3f1c0d5e7b249168a0c4f2d9e6b8135c7a2049fbe31d68075c4e9a1b2f3d40e"
      },
      "expected_error": {
        "field": "name",
        "code": "E_EMPTY"
      }
    },
    {
      "id": "rj-02-id-contains-nul",
      "note": "A U+0000 inside the national id would forge a field boundary, because 0x00 is exactly the separator byte. N4 rejects it, which is what makes the separator sufficient without length prefixes.",
      "input": {
        "name": "Budi Santoso",
        "national_id": "3174\u000001250990",
        "emergency_contact": "+6281234567890",
        "salt_hex": "a3f1c0d5e7b249168a0c4f2d9e6b8135c7a2049fbe31d68075c4e9a1b2f3d40e"
      },
      "expected_error": {
        "field": "national_id",
        "code": "E_NUL"
      }
    },
    {
      "id": "rj-03-id-only-separators",
      "note": "Survives N4 (the trimmed string is non-empty) but N5 strips every character. Rejected by the post-strip emptiness check, N5b.",
      "input": {
        "name": "Budi Santoso",
        "national_id": " -- - ",
        "emergency_contact": "+6281234567890",
        "salt_hex": "a3f1c0d5e7b249168a0c4f2d9e6b8135c7a2049fbe31d68075c4e9a1b2f3d40e"
      },
      "expected_error": {
        "field": "national_id",
        "code": "E_EMPTY"
      }
    },
    {
      "id": "rj-04-contact-only-punctuation",
      "note": "Same shape as rj-03 on the contact field: N6 strips ( ) - and whitespace, leaving nothing. Rejected by N6b.",
