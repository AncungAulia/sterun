{
  "name": "sterun",
  "version": "0.0.0",
  "private": true,
  "description": "Sterun — non-transferable race records on Stellar/Soroban (Instawards MVP)",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter be dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "faucet": "pnpm --filter be faucet",
    "indexer": "pnpm --filter be indexer",
    "keeper": "pnpm --filter be keeper"
  },
  "pnpm": {
    "overrides": {
      "@stellar/stellar-sdk": "^17.0.1"
    }
  }
}
