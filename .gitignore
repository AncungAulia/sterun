# Dependencies (pnpm workspace — one store, symlinked into each package)
node_modules/

# Build output
dist/
.next/
out/
*.tsbuildinfo

# Local environment. The *.example files ARE committed; the filled-in ones never
# are — they hold the distributor secret and PII_KEYS, which open the entire
# vault.
#
# Two negations, not one. `.env.production.example` (STE-31) does not match
# `.env.example`, so the single original exception silently ignored it — which
# is how a file documenting the whole deploy goes missing from the repo.
.env
.env.*
!.env.example
!.env.*.example

# STE-31 — tunnel credentials. `cloudflared tunnel create` writes a JSON holding
# TunnelSecret; whoever has it can attach a tunnel to the Cloudflare account.
# The tunnel UUID is NOT secret (it is in public DNS) and lives in
# deploy/cloudflared-config.yml; this is the half that is.
secrets/

# Editor / OS
.DS_Store
*.swp

# STE-19 — compiled vendored bindings (sdk/vendor/ is the committed source).
vendor-dist/
