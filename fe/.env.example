# Sterun web app — copy to .env.local and keep the values in step with
# docs/deployments.md. Contract addresses are NOT hardcoded in the source:
# v1 contracts are non-upgradeable, so a redeploy is a new pair of addresses.

# Network. Testnet is the default for the Instawards MVP.
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contracts — from docs/deployments.md (STE-30, STE-33).
NEXT_PUBLIC_EVENT_REGISTRY=CDL6A734H5DITOFC5VGSAAIOQBBGSH2NIIDU4KJDAO734I3ZRL4GTA64
NEXT_PUBLIC_RACE_RECORD=CDWFNF427X4R5BABSUUQNPNEVP5QERBGLTHWD5GEHSGFK6E4YME7XNB4
NEXT_PUBLIC_SUSD_SAC=CBQ6444FXNECVHSPECYHUO26V2HFLPAXXGOTWDA5F3RPGH6TD7RDMOOU

# Backend (be/). Left empty until the first ticket that calls it.
NEXT_PUBLIC_API_URL=
